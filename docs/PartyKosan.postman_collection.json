{
  "info": {
    "name": "Party Kosan API",
    "_postman_id": "party-kosan-collection",
    "description": "Koleksi endpoint Party Kosan (Laravel + JWT + OpenAI chatbot). Set variable base_url, jalankan Login untuk mengisi token otomatis. Format response: { status, message, data }.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" },
    { "key": "id_kosan", "value": "1" },
    { "key": "id_kamar", "value": "1" },
    { "key": "id_pemesanan", "value": "1" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    {
      "name": "Auth",
      "item": [
        { "name": "Register", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nama\": \"Budi Santoso\",\n  \"email\": \"budi.baru@example.com\",\n  \"password\": \"rahasia123\",\n  \"no_telp\": \"08123456789\",\n  \"jenis_kelamin\": \"L\"\n}" }, "url": { "raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"] } } },
        { "name": "Login", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var res = pm.response.json();", "if (res.data && res.data.token) {", "  pm.collectionVariables.set('token', res.data.token.access_token);", "}"] } }], "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"budi@partykosan.test\",\n  \"password\": \"password\"\n}" }, "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] } } },
        { "name": "Me", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] } } },
        { "name": "Refresh", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/refresh", "host": ["{{base_url}}"], "path": ["refresh"] } } },
        { "name": "Logout", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] } } }
      ]
    },
    {
      "name": "Kosan & Kamar",
      "item": [
        { "name": "List Kosan (filter)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/kosan?q=&tipe_kosan=&harga_min=&harga_max=", "host": ["{{base_url}}"], "path": ["kosan"], "query": [{ "key": "q", "value": "" }, { "key": "tipe_kosan", "value": "" }, { "key": "harga_min", "value": "" }, { "key": "harga_max", "value": "" }, { "key": "fasilitas[]", "value": "1", "disabled": true }] } } },
        { "name": "Detail Kosan", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/kosan/{{id_kosan}}", "host": ["{{base_url}}"], "path": ["kosan", "{{id_kosan}}"] } } },
        { "name": "Detail Kamar", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/kamar/{{id_kamar}}", "host": ["{{base_url}}"], "path": ["kamar", "{{id_kamar}}"] } } },
        { "name": "List Fasilitas", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/fasilitas", "host": ["{{base_url}}"], "path": ["fasilitas"] } } }
      ]
    },
    {
      "name": "Favorit & Riwayat Dilihat",
      "item": [
        { "name": "List Favorit", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/favorit", "host": ["{{base_url}}"], "path": ["favorit"] } } },
        { "name": "Tambah Favorit", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"id_kamar\": {{id_kamar}}\n}" }, "url": { "raw": "{{base_url}}/favorit", "host": ["{{base_url}}"], "path": ["favorit"] } } },
        { "name": "Hapus Favorit", "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/favorit/{{id_kamar}}", "host": ["{{base_url}}"], "path": ["favorit", "{{id_kamar}}"] } } },
        { "name": "List Riwayat Dilihat", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/riwayat-dilihat", "host": ["{{base_url}}"], "path": ["riwayat-dilihat"] } } },
        { "name": "Catat Riwayat Dilihat", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"id_kamar\": {{id_kamar}}\n}" }, "url": { "raw": "{{base_url}}/riwayat-dilihat", "host": ["{{base_url}}"], "path": ["riwayat-dilihat"] } } }
      ]
    },
    {
      "name": "Pemesanan (Penyewa)",
      "item": [
        { "name": "Buat Pemesanan (durasi)", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"id_kamar\": {{id_kamar}},\n  \"durasi_bulan\": 6\n}" }, "url": { "raw": "{{base_url}}/pemesanan", "host": ["{{base_url}}"], "path": ["pemesanan"] } } },
        { "name": "Buat Pemesanan (tanggal)", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"id_kamar\": {{id_kamar}},\n  \"tanggal_mulai\": \"2026-07-01\",\n  \"tanggal_selesai\": \"2027-01-01\"\n}" }, "url": { "raw": "{{base_url}}/pemesanan", "host": ["{{base_url}}"], "path": ["pemesanan"] } } },
        { "name": "Riwayat Pemesanan", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/riwayat-pemesanan", "host": ["{{base_url}}"], "path": ["riwayat-pemesanan"] } } }
      ]
    },
    {
      "name": "Profil & Privasi",
      "item": [
        { "name": "Get Profil", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/profil", "host": ["{{base_url}}"], "path": ["profil"] } } },
        { "name": "Update Profil", "request": { "method": "PUT", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nama\": \"Budi Santoso\",\n  \"alamat\": \"Jl. Mawar 1\",\n  \"no_telp\": \"08123456789\",\n  \"jenis_kelamin\": \"L\"\n}" }, "url": { "raw": "{{base_url}}/profil", "host": ["{{base_url}}"], "path": ["profil"] } } },
        { "name": "Get Pengaturan Privasi", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/pengaturan-privasi", "host": ["{{base_url}}"], "path": ["pengaturan-privasi"] } } },
        { "name": "Update Pengaturan Privasi", "request": { "method": "PUT", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"informasi_umum\": true,\n  \"informasi_data_diri\": false,\n  \"riwayat_aktivitas\": true,\n  \"riwayat_pencarian_kos\": false\n}" }, "url": { "raw": "{{base_url}}/pengaturan-privasi", "host": ["{{base_url}}"], "path": ["pengaturan-privasi"] } } }
      ]
    },
    {
      "name": "Chatbot AI",
      "item": [
        { "name": "List FAQ", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/faq", "host": ["{{base_url}}"], "path": ["faq"] } } },
        { "name": "Tanya Chatbot", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"pertanyaan\": \"Kamar termurah berapa?\"\n}" }, "url": { "raw": "{{base_url}}/chatbot", "host": ["{{base_url}}"], "path": ["chatbot"] } } },
        { "name": "Clear Chat", "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/chatbot/clear", "host": ["{{base_url}}"], "path": ["chatbot", "clear"] } } }
      ]
    },
    {
      "name": "Pemilik",
      "item": [
        { "name": "Dashboard", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/dashboard", "host": ["{{base_url}}"], "path": ["dashboard"] } } },
        { "name": "Kos Saya (statistik)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/pemilik/kos-saya", "host": ["{{base_url}}"], "path": ["pemilik", "kos-saya"] } } },
        { "name": "List Kosan (milik)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/pemilik/kosan", "host": ["{{base_url}}"], "path": ["pemilik", "kosan"] } } },
        { "name": "Nonaktifkan Kos", "request": { "method": "PUT", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/kosan/{{id_kosan}}/nonaktifkan", "host": ["{{base_url}}"], "path": ["kosan", "{{id_kosan}}", "nonaktifkan"] } } },
        { "name": "Aktifkan Kos", "request": { "method": "PUT", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/kosan/{{id_kosan}}/aktifkan", "host": ["{{base_url}}"], "path": ["kosan", "{{id_kosan}}", "aktifkan"] } } },
        { "name": "Tambah Kosan", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nama_kosan\": \"Kost Mas Amba\",\n  \"alamat\": \"Jl. Kaliurang KM 5\",\n  \"landmark\": \"Dekat UGM\",\n  \"tipe_kosan\": \"putra\",\n  \"deskripsi\": \"Nyaman dan strategis\",\n  \"fasilitas\": [1, 2]\n}" }, "url": { "raw": "{{base_url}}/pemilik/kosan", "host": ["{{base_url}}"], "path": ["pemilik", "kosan"] } } },
        { "name": "Update Kosan", "request": { "method": "PUT", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nama_kosan\": \"Kost Mas Amba (Update)\",\n  \"fasilitas\": [1, 3]\n}" }, "url": { "raw": "{{base_url}}/pemilik/kosan/{{id_kosan}}", "host": ["{{base_url}}"], "path": ["pemilik", "kosan", "{{id_kosan}}"] } } },
        { "name": "Hapus Kosan", "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/pemilik/kosan/{{id_kosan}}", "host": ["{{base_url}}"], "path": ["pemilik", "kosan", "{{id_kosan}}"] } } },
        { "name": "List Kamar (milik)", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/pemilik/kamar", "host": ["{{base_url}}"], "path": ["pemilik", "kamar"] } } },
        { "name": "Tambah Kamar", "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"id_kosan\": {{id_kosan}},\n  \"no_kamar\": \"A-101\",\n  \"tipe\": \"single\",\n  \"harga_bulanan\": 1200000,\n  \"status\": \"tersedia\",\n  \"ukuran\": \"3x3\",\n  \"jenis_kasur\": \"single\"\n}" }, "url": { "raw": "{{base_url}}/pemilik/kamar", "host": ["{{base_url}}"], "path": ["pemilik", "kamar"] } } },
        { "name": "Update Kamar", "request": { "method": "PUT", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"harga_bulanan\": 1300000,\n  \"status\": \"perawatan\"\n}" }, "url": { "raw": "{{base_url}}/pemilik/kamar/{{id_kamar}}", "host": ["{{base_url}}"], "path": ["pemilik", "kamar", "{{id_kamar}}"] } } },
        { "name": "Hapus Kamar", "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/pemilik/kamar/{{id_kamar}}", "host": ["{{base_url}}"], "path": ["pemilik", "kamar", "{{id_kamar}}"] } } },
        { "name": "Permintaan Pemesanan", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/pemilik/pemesanan", "host": ["{{base_url}}"], "path": ["pemilik", "pemesanan"] } } },
        { "name": "Konfirmasi Pemesanan", "request": { "method": "PUT", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"tanggal_mulai\": \"2026-07-01\",\n  \"tanggal_selesai\": \"2027-07-01\",\n  \"catatan_pemilik\": \"Pembayaran telah diterima\"\n}" }, "url": { "raw": "{{base_url}}/pemilik/pemesanan/{{id_pemesanan}}/konfirmasi", "host": ["{{base_url}}"], "path": ["pemilik", "pemesanan", "{{id_pemesanan}}", "konfirmasi"] } } },
        { "name": "Tolak Pemesanan", "request": { "method": "PUT", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"alasan_pembatalan\": \"Kamar sudah terisi\"\n}" }, "url": { "raw": "{{base_url}}/pemilik/pemesanan/{{id_pemesanan}}/tolak", "host": ["{{base_url}}"], "path": ["pemilik", "pemesanan", "{{id_pemesanan}}", "tolak"] } } }
      ]
    }
  ]
}
